{
  "name": "Non-Avian ML",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "../"
  },
  "mounts": [
    "source=${localWorkspaceFolderBasename}-pixi,target=${containerWorkspaceFolder}/.pixi,type=volume"
  ],
  "postCreateCommand": "pixi install && pixi run myst-install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/non-avian-ml/.pixi/envs/default/bin/python"
      }
    }
  },
  "remoteUser": "root"
}